# Claude Code: agent worktrees are ephemeral in-progress checkouts (each is
# its own nested git worktree while a background subagent works in it) and
# settings.local.json is machine-local session config — neither belongs in
# version control.
.claude/worktrees/
.claude/settings.local.json
